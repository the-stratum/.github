
{
  "name": "CodeQL Security Analysis",
  "description": "Scan supported programming languages and GitHub Actions workflows for security vulnerabilities and coding errors.",
  "iconName": "octicon shield-check",
  "categories": [
    "Security",
    "Code scanning"
  ],
  "filePatterns": [
    "^package\\.json$",
    "^requirements\\.txt$",
    "^pyproject\\.toml$",
    "^go\\.mod$",
    "^Cargo\\.toml$",
    "^pom\\.xml$",
    "^build\\.gradle(\\.kts)?$",
    "^Gemfile$",
    "^CMakeLists\\.txt$",
    "^global\\.json$",
    "^[^/]+\\.slnx?$",
    "^[^/]+\\.csproj$",
    "^Package\\.swift$"
  ]
}
